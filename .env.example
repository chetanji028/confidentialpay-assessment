# Backend Server Configuration
PORT=4000

# CORS Configuration (comma-separated for multiple origins)
# Development: use * or http://localhost:3000
# Production: specify your frontend domain(s)
CORS_ORIGIN=http://localhost:3000

# JWT Configuration (if implementing token-based auth)
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRES_IN=12h
# REFRESH_TOKEN_EXPIRES_IN=7d

# Database Configuration (for future PostgreSQL integration)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=confipay
# DB_USER=postgres
# DB_PASSWORD=your-password

# Blockchain Configuration (for multi-chain support)
# INFURA_KEY=your-infura-key
# ALCHEMY_KEY=your-alchemy-key
# SOLANA_RPC=https://api.mainnet-beta.solana.com

# Logging
# LOG_LEVEL=info
# LOG_FORMAT=json
